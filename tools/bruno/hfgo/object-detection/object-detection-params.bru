meta {
  name: Object Detection - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_object_detection}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "inputs": "",
    "parameters": {"threshold": 0.6}
  }
}

script:pre-request {
  const { IMAGE_SAMPLE_URL, download, toBase64 } = require('./scripts/samples.js');
  
  const sample = await download('https://fastly.picsum.photos/id/60/512/512.jpg?hmac=CKdYDj-ZhSmY_J11yU1Ep4CuKgy7LaPKpPY9MQkdzZA');
  const body = req.getBody();
  body.inputs = toBase64(sample);
  req.setBody(body);
}
