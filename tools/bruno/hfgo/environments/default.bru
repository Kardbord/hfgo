vars {
  sample_png: /path/to/your/sample.png
  sample_audio: UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=
  model_chat_completion: google/gemma-2-2b-it
  model_feature_extraction: BAAI/bge-small-en-v1.5
