vars {
  model_chat_completion: zai-org/GLM-5.3
  model_feature_extraction: BAAI/bge-small-en-v1.5
  model_text_to_image: stabilityai/stable-diffusion-3-medium-diffusers
  model_text_to_video: tencent/HunyuanVideo
  model_audio_classification: MIT/ast-finetuned-audioset-10-10
  model_automatic_speech_recognition: openai/whisper-large-v3
  model_fill_mask: google-bert/bert-base-uncased
  model_image_classification: google/vit-base-patch16-224
  model_image_segmentation: facebook/mask2former-swin-large-coco-panoptic
  model_image_text_to_text: deepseek-ai/DeepSeek-V4.1-Flash
  model_image_to_image: black-forest-labs/flux-2-klein-9b
  model_object_detection: facebook/detr-resnet-50
  model_question_answering: deepset/roberta-base-squad2
  model_summarization: facebook/bart-large-cnn
  model_table_question_answering: google/tapas-base-finetuned-wtq
  model_text_classification: ProsusAI/finbert
  model_text_generation: google/gemma-2-2b-it
  model_token_classification: dslim/bert-base-NER
  model_translation: google-t5/t5-small
  model_zero_shot_classification: facebook/bart-large-mnli
  HF_BASE_URL: https://router.huggingface.co
}
vars:secret [
  HF_TOKEN
]
