meta {
  name: Image to Image - Params
  type: http
  seq: 1
}

post {
  url: {{HF_BASE_URL}}/wavespeed/api/v3/{{model_image_to_image}}
  body: json
  auth: inherit
}

headers {
  Accept: */*
  Content-Type: application/json
}

body:json {
  {
    "guidance_scale": 7.5,
    "negative_prompt": "blurry, low quality",
    "num_inference_steps": 30,
    "prompt": "Make this photo look like an oil painting."
  }
}

script:pre-request {
  const { IMAGE_SAMPLE_URL, download, toDataUri } = require('./scripts/samples.js');
  
  const sample = await download(IMAGE_SAMPLE_URL);
  const body = req.getBody();
  body.images = [toDataUri(sample)];
  req.setBody(body);
  
}
