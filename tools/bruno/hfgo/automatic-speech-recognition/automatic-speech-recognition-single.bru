meta {
  name: Automatic Speech Recognition - Single
  type: http
  seq: 1
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_automatic_speech_recognition}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:pre-request {
  const { AUDIO_SAMPLE_URL, download } = require('./scripts/samples.js');
  
  const sample = await download(AUDIO_SAMPLE_URL);
  req.setHeader('Content-Type', sample.contentType);
  req.setBody(sample.bytes, { raw: true });
}
