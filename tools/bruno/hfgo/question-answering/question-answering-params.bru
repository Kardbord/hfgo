meta {
  name: Question Answering - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_question_answering}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "inputs": {
      "question": "What year was Go created?",
      "context": "Go, first released in 2009, was created at Google by Robert Griesemer, Rob Pike, and Ken Thompson."
    },
    "parameters": {
      "top_k": 3,
      "max_answer_len": 30,
      "handle_impossible_answer": true
    }
  }
}
