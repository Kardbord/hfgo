meta {
  name: Image Text to Text - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model_image_text_to_text}}",
    "max_tokens": 300,
    "temperature": 0.8,
    "top_p": 0.95,
    "messages": [
      {
        "role": "user",
        "content": [
          {"type": "text", "text": "Describe this image in detail."},
          {"type": "image_url", "image_url": {"url": ""}}
        ]
      }
    ]
  }
}

script:pre-request {
  const { IMAGE_SAMPLE_URL, download, toDataUri } = require('./scripts/samples.js');

  const sample = await download(IMAGE_SAMPLE_URL);
  const body = req.getBody();
  body.messages[0].content[1].image_url.url = toDataUri(sample);
  req.setBody(body);
}
