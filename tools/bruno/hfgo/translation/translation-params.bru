meta {
  name: Translation - Params
  type: http
  seq: 3
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_translation}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "inputs": "The weather is lovely and sunny today.",
    "parameters": {
      "src_lang": "en",
      "tgt_lang": "de",
      "clean_up_tokenization_spaces": true,
      "truncation": "only_first"
    }
  }
}
